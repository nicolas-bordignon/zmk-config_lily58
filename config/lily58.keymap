/*
 * ZMK Scylla Ultimate V23 - Cognitive Flow, Undead Code Layer & Gaming Precision
 * - Workspaces: 1 (DEV), 2 (LAB), 3 (COM), 4 (GAM)
 * - Navigation: Vim HJKL + Setas alinhadas + Print de Área (m_shot) + Swap Master
 * - Code Layer: Símbolos literais sem Dead Key (RA), ?, !, _ nos indicadores e Numpad 3x3
 * - Combos PT-BR (exclusivos da DEF com require-prior-idle-ms): C+D = ç/Ç | R+S = ~ | S+T = ´ | X+C = ^
 * - Combos CLI: W+F = & | F+P = |
 * - Gaming Layer: QWERTY alinhado com T/G/B na mão esquerda e LALT no polegar (sem LGUI acidental)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define CODE 1
#define NAV 2
#define GAM 3
#define SYS 4

/ {
    macros {
        k_arr: kotlin-arrow {
            label = "KOTLIN_ARROW";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp GT &kp SPACE>;
        };

        k_tpl: kotlin-template {
            label = "KOTLIN_TEMPLATE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DLLR &kp LBRC &kp RBRC &kp LEFT>;
        };

        m_shot: screenshot {
            label = "SCREENSHOT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(P))>;
        };
    };

    behaviors {
        /* Home Row: Tap-Preferred com proteção anti-roll (require-prior-idle-ms + quick-tap-ms) */
        hm: homerow-mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Thumbs: Balanced com quick-tap para repetição imediata */
        tm: thumb-mod {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_MOD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        tl: thumb-layer {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        sk: sticky_key {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY";
            #binding-cells = <1>;
            release-after-ms = <2000>;
            quick-release;
            bindings = <&kp>;
        };

        sl: sticky_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_LAYER";
            #binding-cells = <1>;
            release-after-ms = <2000>;
            bindings = <&mo>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* PT-BR: C + D = ç / Ç (Mão esquerda, médio + indicador inferiores) */
        combo_cedilla {
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            key-positions = <39 40>;
            bindings = <&kp RA(COMMA)>;
            layers = <DEF>;
        };

        /* PT-BR: R + S = ~ dead key para ã/õ (Mão esquerda, anelar + médio Home Row) */
        combo_tilde {
            timeout-ms = <30>;
            require-prior-idle-ms = <125>;
            key-positions = <26 27>;
            bindings = <&kp TILDE>;
            layers = <DEF>;
        };

        /* PT-BR: S + T = ´ dead key para á/é/í/ó/ú (Mão esquerda, médio + indicador Home Row) */
        combo_acute {
            timeout-ms = <30>;
            require-prior-idle-ms = <125>;
            key-positions = <27 28>;
            bindings = <&kp SQT>;
            layers = <DEF>;
        };

        /* PT-BR: X + C = ^ dead key para â/ê/ô (Mão esquerda, anelar + médio inferiores) */
        combo_caret {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <38 39>;
            bindings = <&kp CARET>;
            layers = <DEF>;
        };

        /* CLI: W + F = & (Mão esquerda, anelar + médio Linha 1) */
        combo_amps {
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            key-positions = <14 15>;
            bindings = <&kp AMPS>;
            layers = <DEF CODE>;
        };

        /* CLI: F + P = | (Mão esquerda, médio + indicador Linha 1) */
        combo_pipe {
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
            key-positions = <15 16>;
            bindings = <&kp PIPE>;
            layers = <DEF CODE>;
        };

        /* Sistema: Q + A = Camada SYS (Mão esquerda, anelar Linha 1 + Home Row) */
        combo_sys {
            timeout-ms = <60>;
            key-positions = <13 25>;
            bindings = <&mo SYS>;
        };

        /* Atalho de seleção global: J + L = Ctrl + A */
        combo_select_all {
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
            key-positions = <18 19>;
            bindings = <&kp LC(A)>;
            layers = <DEF>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <CODE NAV>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ------------------------------------------------------------------------------------------------------------
         * 0. DEFAULT LAYER (DEF) — Colemak-DH + Home Row Mods
         * ------------------------------------------------------------------------------------------------------------ */
        default_layer {
            bindings = <
&kp ESC   &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                             &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp PSCRN
&kp TAB   &kp Q        &kp W        &kp F        &kp P        &kp B                              &kp J        &kp L        &kp U        &kp Y        &kp SEMI     &kp SQT
&kp LCTRL &hm LCTRL A  &hm LALT R   &hm LGUI S   &hm LSHFT T  &kp G                              &kp M        &hm RSHFT N  &hm RGUI E   &hm RALT I   &hm RCTRL O  &kp RET
&kp LSHFT &kp Z        &kp X        &kp C        &kp D        &kp V        &kp TAB    &kp DEL    &kp K        &kp H        &kp COMMA    &kp DOT      &kp FSLH     &kp DEL
                                    &kp LGUI     &mo CODE     &kp SPACE    &kp ESC    &kp BSPC   &kp RET      &mo NAV      &kp RSHFT
            >;
        };

        /* ------------------------------------------------------------------------------------------------------------
         * 1. CODE LAYER (CODE) — Símbolos Literais (Sem Dead Key), Delimitadores e Teclado Numérico 3x3
         * ------------------------------------------------------------------------------------------------------------ */
        code_layer {
            bindings = <
&kp RA(TILDE) &kp EXCL   &kp AT       &kp HASH      &k_tpl       &kp PRCNT                          &kp RA(CARET) &kp AMPS   &kp PIPE     &kp SEMI     &kp BSLH     &k_arr
&trans        &kp LBRC   &kp RBRC     &kp LT        &kp GT       &kp EXCL                           &kp FSLH      &kp N7     &kp N8       &kp N9       &kp STAR     &kp PLUS
&trans        &kp LPAR   &kp RPAR     &kp RA(SQT)   &kp RA(DQT)  &kp UNDER                          &kp DOT       &kp N4     &kp N5       &kp N6       &kp MINUS    &kp EQUAL
&trans        &kp LBKT   &kp RBKT     &kp RA(GRAVE) &kp DLLR     &kp QMARK    &trans   &trans       &kp N0        &kp N1     &kp N2       &kp N3       &kp COLON    &kp BSLH
                                      &trans        &trans       &trans       &trans   &trans       &trans        &trans     &trans
            >;
        };

        /* ------------------------------------------------------------------------------------------------------------
         * 2. NAVIGATION LAYER (NAV) — Vim HJKL + Hyprland Workspaces (1, 2, 3, 4) + Print de Área
         * ------------------------------------------------------------------------------------------------------------ */
        nav_layer {
            bindings = <
&kp F1    &kp F2       &kp F3       &kp F4            &kp F5       &kp F6                             &kp F7          &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
&trans    &kp LG(Q)    &kp LG(F)    &kp LG(LS(SPACE)) &kp LG(G)    &kp LG(S)                          &m_shot         &kp HOME     &kp PG_UP    &kp PG_DN    &kp END      &m_shot
&trans    &kp LG(N1)   &kp LG(N2)   &kp LG(N3)        &kp LG(N4)   &kp LG(M)                          &kp LG(LS(RET)) &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &trans
&trans    &kp LG(LS(N1)) &kp LG(LS(N2)) &kp LG(LS(N3)) &kp LG(LS(N4)) &trans  &trans   &tog GAM       &trans          &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &kp C_PP     &trans
                                    &trans            &trans       &trans     &trans   &trans         &trans          &trans       &trans
            >;
        };

        /* ------------------------------------------------------------------------------------------------------------
         * 3. GAMING LAYER (GAM) — QWERTY Puro Alinhado (T/G/B na Mão Esquerda + LALT no Polegar)
         * ------------------------------------------------------------------------------------------------------------ */
        gaming_layer {
            bindings = <
&kp ESC   &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                             &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp BSPC
&kp TAB   &kp Q        &kp W        &kp E        &kp R        &kp T                              &kp Y        &kp U        &kp I        &kp O        &kp P        &kp RET
&kp LSHFT &kp A        &kp S        &kp D        &kp F        &kp G                              &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp SQT
&kp LCTRL &kp Z        &kp X        &kp C        &kp V        &kp B        &kp TAB   &tog GAM    &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &tog GAM
                                    &kp LALT     &kp LCTRL    &kp SPACE    &kp ESC   &kp BSPC    &kp RET      &tog GAM     &kp RSHFT
            >;
        };

        /* ------------------------------------------------------------------------------------------------------------
         * 4. SYSTEM LAYER (SYS) — Bluetooth, USB Output & Bootloader
         * ------------------------------------------------------------------------------------------------------------ */
        system_layer {
            bindings = <
&bootloader  &sys_reset   &none        &none        &none        &bt BT_CLR                         &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bootloader
&out OUT_BLE &out OUT_USB &none        &none        &none        &none                              &none        &none        &none        &none        &none        &sys_reset
&none        &none        &none        &none        &none        &none                              &none        &none        &none        &none        &none        &none
&none        &none        &none        &none        &none        &none        &none     &none       &none        &none        &none        &none        &none        &none
                                       &none        &none        &none        &none     &none       &none        &none        &none
            >;
        };
    };
};
/* EOF */
